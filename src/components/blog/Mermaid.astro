---
import { renderMermaidSVG } from 'beautiful-mermaid'
import { mermaidTheme } from '../../data/mermaid-theme'

interface Props {
  caption?: string
  chart: string
}

const { caption, chart } = Astro.props

function preprocessChart(input: string): string {
  return input.replace(/(\["[^"]*"\]|\{"[^"]*"\}|\|"[^"]*"\|)/gs, (match) =>
    match.replace(/\n/g, '<br/>')
  )
}

const svg = renderMermaidSVG(preprocessChart(chart), mermaidTheme)
---

<figure class="mermaid-figure">
  <Fragment set:html={svg} />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
